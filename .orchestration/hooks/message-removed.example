#!/usr/bin/env bash
# message-removed.example - opencode server event "message.removed".
# The daemon's SSE consumer fires this when the server emits "message.removed": copy this
# file to .orchestration/hooks/message-removed, make it executable, and commit it. The
# event arrives as JSON on stdin, with ORCH_EVENT=message-removed (plus session/project env
# when one applies).
# Fire-and-forget: a non-zero exit is logged to ~/.local/state/orch, never
# blocking the stream.
# Properties: the event JSON is on stdin (V2 puts them under `data`)

set -uo pipefail
read -r payload
echo "message-removed (opencode event): $payload"
exit 0
