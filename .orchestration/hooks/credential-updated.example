#!/usr/bin/env bash
# credential-updated.example - opencode server event "credential.updated".
# The daemon's SSE consumer fires this when the server emits "credential.updated": copy this
# file to .orchestration/hooks/credential-updated, make it executable, and commit it. The
# event arrives as JSON on stdin, with ORCH_EVENT=credential-updated (plus session/project env
# when one applies).
# Fire-and-forget: a non-zero exit is logged to ~/.local/state/orch, never
# blocking the stream.
# Properties: the event JSON is on stdin (V2 puts them under `data`)

set -uo pipefail
read -r payload
echo "credential-updated (opencode event): $payload"
exit 0
