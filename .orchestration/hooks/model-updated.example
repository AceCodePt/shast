#!/usr/bin/env bash
# model-updated.example - opencode server event "model.updated".
# The daemon's SSE consumer fires this when the server emits "model.updated": copy this
# file to .orchestration/hooks/model-updated, make it executable, and commit it. The
# event arrives as JSON on stdin, with ORCH_EVENT=model-updated (plus session/project env
# when one applies).
# Fire-and-forget: a non-zero exit is logged to ~/.local/state/orch, never
# blocking the stream.
# Properties: the event JSON is on stdin (V2 puts them under `data`)

set -uo pipefail
read -r payload
echo "model-updated (opencode event): $payload"
exit 0
