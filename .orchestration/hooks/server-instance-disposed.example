#!/usr/bin/env bash
# server-instance-disposed.example - opencode server event "server.instance.disposed".
# The daemon's SSE consumer fires this when the server emits "server.instance.disposed": copy this
# file to .orchestration/hooks/server-instance-disposed, make it executable, and commit it. The
# event arrives as JSON on stdin, with ORCH_EVENT=server-instance-disposed (plus session/project env
# when one applies).
# Fire-and-forget: a non-zero exit is logged to ~/.local/state/orch, never
# blocking the stream.
# Properties: the event JSON is on stdin (V2 puts them under `data`)

set -uo pipefail
read -r payload
echo "server-instance-disposed (opencode event): $payload"
exit 0
