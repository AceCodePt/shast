#!/usr/bin/env bash
# file-edited.example - opencode server event "file.edited".
# The daemon's SSE consumer fires this when the server emits "file.edited": copy this
# file to .orchestration/hooks/file-edited, make it executable, and commit it. The
# event arrives as JSON on stdin, with ORCH_EVENT=file-edited (plus session/project env
# when one applies).
# Fire-and-forget: a non-zero exit is logged to ~/.local/state/orch, never
# blocking the stream.
# Properties: the event JSON is on stdin (V2 puts them under `data`)

set -uo pipefail
read -r payload
echo "file-edited (opencode event): $payload"
exit 0
