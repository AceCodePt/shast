#!/usr/bin/env bash
# form-cancelled.example - opencode server event "form.cancelled".
# The daemon's SSE consumer fires this when the server emits "form.cancelled": copy this
# file to .orchestration/hooks/form-cancelled, make it executable, and commit it. The
# event arrives as JSON on stdin, with ORCH_EVENT=form-cancelled (plus session/project env
# when one applies).
# Fire-and-forget: a non-zero exit is logged to ~/.local/state/orch, never
# blocking the stream.
# Properties: the event JSON is on stdin (V2 puts them under `data`)

set -uo pipefail
read -r payload
echo "form-cancelled (opencode event): $payload"
exit 0
