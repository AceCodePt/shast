#!/usr/bin/env bash
# command-executed.example - opencode server event "command.executed".
# The daemon's SSE consumer fires this when the server emits "command.executed": copy this
# file to .orchestration/hooks/command-executed, make it executable, and commit it. The
# event arrives as JSON on stdin, with ORCH_EVENT=command-executed (plus session/project env
# when one applies).
# Fire-and-forget: a non-zero exit is logged to ~/.local/state/orch, never
# blocking the stream.
# Properties: the event JSON is on stdin (V2 puts them under `data`)

set -uo pipefail
read -r payload
echo "command-executed (opencode event): $payload"
exit 0
