#!/usr/bin/env bash
# session-status.example - opencode server event "session.status".
# The daemon's SSE consumer fires this when the server emits "session.status": copy this
# file to .orchestration/hooks/session-status, make it executable, and commit it. The
# event arrives as JSON on stdin, with ORCH_EVENT=session-status (plus session/project env
# when one applies).
# Fire-and-forget: a non-zero exit is logged to ~/.local/state/orch, never
# blocking the stream.
# Properties: the event JSON is on stdin (V2 puts them under `data`)

set -uo pipefail
read -r payload
echo "session-status (opencode event): $payload"
exit 0
