#!/usr/bin/env bash
# permission-replied.example - opencode server event "permission.replied".
# The daemon's SSE consumer fires this when the server emits "permission.replied": copy this
# file to .orchestration/hooks/permission-replied, make it executable, and commit it. The
# event arrives as JSON on stdin, with ORCH_EVENT=permission-replied (plus session/project env
# when one applies).
# Fire-and-forget: a non-zero exit is logged to ~/.local/state/orch, never
# blocking the stream.
# Properties: the event JSON is on stdin (V2 puts them under `data`)

set -uo pipefail
read -r payload
echo "permission-replied (opencode event): $payload"
exit 0
