#!/usr/bin/env bash
# provider-use.example - opencode server event "provider.use".
# The daemon's SSE consumer fires this when the server emits "provider.use": copy this
# file to .orchestration/hooks/provider-use, make it executable, and commit it. The
# event arrives as JSON on stdin, with ORCH_EVENT=provider-use (plus session/project env
# when one applies).
# Fire-and-forget: a non-zero exit is logged to ~/.local/state/orch, never
# blocking the stream.
# Properties: the event JSON is on stdin (V2 puts them under `data`)

set -uo pipefail
read -r payload
echo "provider-use (opencode event): $payload"
exit 0
