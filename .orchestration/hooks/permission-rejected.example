#!/usr/bin/env bash
# permission-rejected.example - opencode server event "permission.rejected".
# The daemon's SSE consumer fires this when the server emits "permission.rejected": copy this
# file to .orchestration/hooks/permission-rejected, make it executable, and commit it. The
# event arrives as JSON on stdin, with ORCH_EVENT=permission-rejected (plus session/project env
# when one applies).
# Fire-and-forget: a non-zero exit is logged to ~/.local/state/orch, never
# blocking the stream.
# Properties: the event JSON is on stdin (V2 puts them under `data`)

set -uo pipefail
read -r payload
echo "permission-rejected (opencode event): $payload"
exit 0
