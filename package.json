{
	"name": "@ace-code/shast",
	"version": "0.1.0",
	"publishConfig": {
		"access": "public"
	},
	"description": "AI-first constrained UI format and validated server-side renderer with structurally coupled HTML and CSS",
	"main": "src/index.ts",
	"type": "module",
	"scripts": {
		"test": "tsc --noEmit && node --import=tsx/esm --test",
		"test:watch": "node --import=tsx/esm --test --watch"
	},
	"keywords": [
		"html",
		"css",
		"ast",
		"semantic",
		"typescript",
		"type-safe",
		"scoped-css",
		"components",
		"validation"
	],
	"author": "Sagi Carmel (https://github.com/AceCodePt)",
	"license": "MIT",
	"packageManager": "pnpm@11.15.0",
	"devDependencies": {
		"@total-typescript/ts-reset": "^0.6.1",
		"@types/node": "^26.1.1",
		"tsx": "^4.22.4"
	},
	"dependencies": {
		"typescript": "^7.0.2"
	}
}
