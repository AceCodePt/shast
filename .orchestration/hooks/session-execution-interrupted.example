#!/usr/bin/env bash
# session-execution-interrupted.example - opencode server event "session.execution.interrupted".
# The daemon's SSE consumer fires this when the server emits "session.execution.interrupted": copy this
# file to .orchestration/hooks/session-execution-interrupted, make it executable, and commit it. The
# event arrives as JSON on stdin, with ORCH_EVENT=session-execution-interrupted (plus session/project env
# when one applies).
# Fire-and-forget: a non-zero exit is logged to ~/.local/state/orch, never
# blocking the stream.
# Properties: the event JSON is on stdin (V2 puts them under `data`)

set -uo pipefail
read -r payload
echo "session-execution-interrupted (opencode event): $payload"
exit 0
