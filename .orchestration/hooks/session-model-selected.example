#!/usr/bin/env bash
# session-model-selected.example - opencode server event "session.model.selected".
# The daemon's SSE consumer fires this when the server emits "session.model.selected": copy this
# file to .orchestration/hooks/session-model-selected, make it executable, and commit it. The
# event arrives as JSON on stdin, with ORCH_EVENT=session-model-selected (plus session/project env
# when one applies).
# Fire-and-forget: a non-zero exit is logged to ~/.local/state/orch, never
# blocking the stream.
# Properties: the event JSON is on stdin (V2 puts them under `data`)

set -uo pipefail
read -r payload
echo "session-model-selected (opencode event): $payload"
exit 0
