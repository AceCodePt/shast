#!/usr/bin/env bash
# config-updated.example - opencode server event "config.updated".
# The daemon's SSE consumer fires this when the server emits "config.updated": copy this
# file to .orchestration/hooks/config-updated, make it executable, and commit it. The
# event arrives as JSON on stdin, with ORCH_EVENT=config-updated (plus session/project env
# when one applies).
# Fire-and-forget: a non-zero exit is logged to ~/.local/state/orch, never
# blocking the stream.
# Properties: the event JSON is on stdin (V2 puts them under `data`)

set -uo pipefail
read -r payload
echo "config-updated (opencode event): $payload"
exit 0
