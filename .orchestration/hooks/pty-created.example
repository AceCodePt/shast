#!/usr/bin/env bash
# pty-created.example - opencode server event "pty.created".
# The daemon's SSE consumer fires this when the server emits "pty.created": copy this
# file to .orchestration/hooks/pty-created, make it executable, and commit it. The
# event arrives as JSON on stdin, with ORCH_EVENT=pty-created (plus session/project env
# when one applies).
# Fire-and-forget: a non-zero exit is logged to ~/.local/state/orch, never
# blocking the stream.
# Properties: the event JSON is on stdin (V2 puts them under `data`)

set -uo pipefail
read -r payload
echo "pty-created (opencode event): $payload"
exit 0
