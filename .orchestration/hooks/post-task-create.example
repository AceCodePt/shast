#!/usr/bin/env bash
# post-task-create.example - right after the task worktree is created, from the new worktree.
# Copy this file to .orchestration/hooks/post-task-create, make it executable, and commit
# it to enable. Fired with TASK_NAME  BRANCH_NAME  WORKTREE_PATH  WORKTREE_NAME
# BASE_BRANCH. Exit 0 lets the event proceed; non-zero aborts it and the failure
# is logged.

set -uo pipefail
echo "post-task-create (example): no-op"
exit 0
