#!/usr/bin/env bash
# session-step-started.example - opencode server event "session.step.started".
# The daemon's SSE consumer fires this when the server emits "session.step.started": copy this
# file to .orchestration/hooks/session-step-started, make it executable, and commit it. The
# event arrives as JSON on stdin, with ORCH_EVENT=session-step-started (plus session/project env
# when one applies).
# Fire-and-forget: a non-zero exit is logged to ~/.local/state/orch, never
# blocking the stream.
# Properties: the event JSON is on stdin (V2 puts them under `data`)

set -uo pipefail
read -r payload
echo "session-step-started (opencode event): $payload"
exit 0
