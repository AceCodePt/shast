#!/usr/bin/env bash
# pty-deleted.example - opencode server event "pty.deleted".
# The daemon's SSE consumer fires this when the server emits "pty.deleted": copy this
# file to .orchestration/hooks/pty-deleted, make it executable, and commit it. The
# event arrives as JSON on stdin, with ORCH_EVENT=pty-deleted (plus session/project env
# when one applies).
# Fire-and-forget: a non-zero exit is logged to ~/.local/state/orch, never
# blocking the stream.
# Properties: the event JSON is on stdin (V2 puts them under `data`)

set -uo pipefail
read -r payload
echo "pty-deleted (opencode event): $payload"
exit 0
