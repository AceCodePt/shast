#!/usr/bin/env bash
# pty-exited.example - opencode server event "pty.exited".
# The daemon's SSE consumer fires this when the server emits "pty.exited": copy this
# file to .orchestration/hooks/pty-exited, make it executable, and commit it. The
# event arrives as JSON on stdin, with ORCH_EVENT=pty-exited (plus session/project env
# when one applies).
# Fire-and-forget: a non-zero exit is logged to ~/.local/state/orch, never
# blocking the stream.
# Properties: the event JSON is on stdin (V2 puts them under `data`)

set -uo pipefail
read -r payload
echo "pty-exited (opencode event): $payload"
exit 0
