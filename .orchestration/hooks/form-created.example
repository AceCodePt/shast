#!/usr/bin/env bash
# form-created.example - opencode server event "form.created".
# The daemon's SSE consumer fires this when the server emits "form.created": copy this
# file to .orchestration/hooks/form-created, make it executable, and commit it. The
# event arrives as JSON on stdin, with ORCH_EVENT=form-created (plus session/project env
# when one applies).
# Fire-and-forget: a non-zero exit is logged to ~/.local/state/orch, never
# blocking the stream.
# Properties: the event JSON is on stdin (V2 puts them under `data`)

set -uo pipefail
read -r payload
echo "form-created (opencode event): $payload"
exit 0
