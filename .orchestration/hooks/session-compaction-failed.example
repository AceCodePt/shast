#!/usr/bin/env bash
# session-compaction-failed.example - opencode server event "session.compaction.failed".
# The daemon's SSE consumer fires this when the server emits "session.compaction.failed": copy this
# file to .orchestration/hooks/session-compaction-failed, make it executable, and commit it. The
# event arrives as JSON on stdin, with ORCH_EVENT=session-compaction-failed (plus session/project env
# when one applies).
# Fire-and-forget: a non-zero exit is logged to ~/.local/state/orch, never
# blocking the stream.
# Properties: the event JSON is on stdin (V2 puts them under `data`)

set -uo pipefail
read -r payload
echo "session-compaction-failed (opencode event): $payload"
exit 0
