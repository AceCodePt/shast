#!/usr/bin/env bash
# session-tool-input-started.example - opencode server event "session.tool.input.started".
# The daemon's SSE consumer fires this when the server emits "session.tool.input.started": copy this
# file to .orchestration/hooks/session-tool-input-started, make it executable, and commit it. The
# event arrives as JSON on stdin, with ORCH_EVENT=session-tool-input-started (plus session/project env
# when one applies).
# Fire-and-forget: a non-zero exit is logged to ~/.local/state/orch, never
# blocking the stream.
# Properties: the event JSON is on stdin (V2 puts them under `data`)

set -uo pipefail
read -r payload
echo "session-tool-input-started (opencode event): $payload"
exit 0
