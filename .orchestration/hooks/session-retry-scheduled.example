#!/usr/bin/env bash
# session-retry-scheduled.example - opencode server event "session.retry.scheduled".
# The daemon's SSE consumer fires this when the server emits "session.retry.scheduled": copy this
# file to .orchestration/hooks/session-retry-scheduled, make it executable, and commit it. The
# event arrives as JSON on stdin, with ORCH_EVENT=session-retry-scheduled (plus session/project env
# when one applies).
# Fire-and-forget: a non-zero exit is logged to ~/.local/state/orch, never
# blocking the stream.
# Properties: the event JSON is on stdin (V2 puts them under `data`)

set -uo pipefail
read -r payload
echo "session-retry-scheduled (opencode event): $payload"
exit 0
