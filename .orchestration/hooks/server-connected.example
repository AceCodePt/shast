#!/usr/bin/env bash
# server-connected.example - opencode server event "server.connected".
# The daemon's SSE consumer fires this when the server emits "server.connected": copy this
# file to .orchestration/hooks/server-connected, make it executable, and commit it. The
# event arrives as JSON on stdin, with ORCH_EVENT=server-connected (plus session/project env
# when one applies).
# Fire-and-forget: a non-zero exit is logged to ~/.local/state/orch, never
# blocking the stream.
# Properties: the event JSON is on stdin (V2 puts them under `data`)

set -uo pipefail
read -r payload
echo "server-connected (opencode event): $payload"
exit 0
