#!/usr/bin/env bash
# session-text-delta.example - opencode server event "session.text.delta".
# The daemon's SSE consumer fires this when the server emits "session.text.delta": copy this
# file to .orchestration/hooks/session-text-delta, make it executable, and commit it. The
# event arrives as JSON on stdin, with ORCH_EVENT=session-text-delta (plus session/project env
# when one applies).
# Fire-and-forget: a non-zero exit is logged to ~/.local/state/orch, never
# blocking the stream.
# Properties: the event JSON is on stdin (V2 puts them under `data`)

set -uo pipefail
read -r payload
echo "session-text-delta (opencode event): $payload"
exit 0
