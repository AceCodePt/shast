#!/usr/bin/env bash
# prompt-clear.example - opencode server event "prompt.clear".
# The daemon's SSE consumer fires this when the server emits "prompt.clear": copy this
# file to .orchestration/hooks/prompt-clear, make it executable, and commit it. The
# event arrives as JSON on stdin, with ORCH_EVENT=prompt-clear (plus session/project env
# when one applies).
# Fire-and-forget: a non-zero exit is logged to ~/.local/state/orch, never
# blocking the stream.
# Properties: the event JSON is on stdin (V2 puts them under `data`)

set -uo pipefail
read -r payload
echo "prompt-clear (opencode event): $payload"
exit 0
