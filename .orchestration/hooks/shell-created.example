#!/usr/bin/env bash
# shell-created.example - opencode server event "shell.created".
# The daemon's SSE consumer fires this when the server emits "shell.created": copy this
# file to .orchestration/hooks/shell-created, make it executable, and commit it. The
# event arrives as JSON on stdin, with ORCH_EVENT=shell-created (plus session/project env
# when one applies).
# Fire-and-forget: a non-zero exit is logged to ~/.local/state/orch, never
# blocking the stream.
# Properties: the event JSON is on stdin (V2 puts them under `data`)

set -uo pipefail
read -r payload
echo "shell-created (opencode event): $payload"
exit 0
