#!/usr/bin/env bash
# session-inbox-delivered.example - opencode server event "session.inbox.delivered".
# The daemon's SSE consumer fires this when the server emits "session.inbox.delivered": copy this
# file to .orchestration/hooks/session-inbox-delivered, make it executable, and commit it. The
# event arrives as JSON on stdin, with ORCH_EVENT=session-inbox-delivered (plus session/project env
# when one applies).
# Fire-and-forget: a non-zero exit is logged to ~/.local/state/orch, never
# blocking the stream.
# Properties: the event JSON is on stdin (V2 puts them under `data`)

set -uo pipefail
read -r payload
echo "session-inbox-delivered (opencode event): $payload"
exit 0
