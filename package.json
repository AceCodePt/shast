{
	"name": "@ace-code/shast",
	"version": "0.1.1",
	"publishConfig": {
		"access": "public"
	},
	"description": "AI-first constrained UI format and validated server-side renderer with structurally coupled HTML and CSS",
	"type": "module",
	"files": [
		"src",
		"scripts/cli.mjs",
		"README.md",
		"LICENSE"
	],
	"bin": {
		"shast": "./scripts/cli.mjs"
	},
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "rolldown scripts/cli.ts -f esm -p node -o scripts/cli.mjs && chmod +x scripts/cli.mjs",
		"prepublishOnly": "pnpm build",
		"check": "tsc --noEmit",
		"shast": "npx tsx scripts/cli.ts",
		"test": "tsc --noEmit && node --import=tsx/esm --test",
		"test:watch": "node --import=tsx/esm --test --watch",
		"example": "npx tsx examples/basic.ts",
		"playground": "npx tsx examples/playground.ts"
	},
	"keywords": [
		"html",
		"css",
		"ast",
		"semantic",
		"typescript",
		"type-safe",
		"scoped-css",
		"components",
		"validation"
	],
	"author": "Sagi Carmel (https://github.com/AceCodePt)",
	"license": "MIT",
	"packageManager": "pnpm@11.17.0",
	"devDependencies": {
		"@types/node": "^26.1.2",
		"rolldown": "^1.2.11",
		"tsx": "^4.23.1",
		"typescript": "^7.0.2"
	},
	"dependencies": {
		"tsyntax": "^1.0.1"
	}
}
