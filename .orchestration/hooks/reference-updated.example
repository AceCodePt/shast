#!/usr/bin/env bash
# reference-updated.example - opencode server event "reference.updated".
# The daemon's SSE consumer fires this when the server emits "reference.updated": copy this
# file to .orchestration/hooks/reference-updated, make it executable, and commit it. The
# event arrives as JSON on stdin, with ORCH_EVENT=reference-updated (plus session/project env
# when one applies).
# Fire-and-forget: a non-zero exit is logged to ~/.local/state/orch, never
# blocking the stream.
# Properties: the event JSON is on stdin (V2 puts them under `data`)

set -uo pipefail
read -r payload
echo "reference-updated (opencode event): $payload"
exit 0
