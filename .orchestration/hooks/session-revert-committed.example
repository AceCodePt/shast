#!/usr/bin/env bash
# session-revert-committed.example - opencode server event "session.revert.committed".
# The daemon's SSE consumer fires this when the server emits "session.revert.committed": copy this
# file to .orchestration/hooks/session-revert-committed, make it executable, and commit it. The
# event arrives as JSON on stdin, with ORCH_EVENT=session-revert-committed (plus session/project env
# when one applies).
# Fire-and-forget: a non-zero exit is logged to ~/.local/state/orch, never
# blocking the stream.
# Properties: the event JSON is on stdin (V2 puts them under `data`)

set -uo pipefail
read -r payload
echo "session-revert-committed (opencode event): $payload"
exit 0
